{
	"$schema": "node_modules/wrangler/config-schema.json",
	// "foodia" is the Pages project's internal name in Cloudflare's dashboard — cosmetic, doesn't
	// need to match the eventual production domain, which is bound separately via a Custom Domain
	// once the project exists. Same convention personali's own wrangler.jsonc already establishes.
	"name": "foodia",
	// pages_build_output_dir is what marks this as a Cloudflare Pages project (vs a plain Worker)
	// and makes @sveltejs/adapter-cloudflare emit the Pages bundle (_worker.js + _routes.json) there.
	"pages_build_output_dir": ".svelte-kit/cloudflare",
	"compatibility_date": "2026-07-28",
	"compatibility_flags": ["nodejs_compat"],
	// D1 (Session 16 — see CLAUDE.md Section 1's own updated entry for why Cloudflare-native, not
	// Django). Real database, created via `wrangler d1 create foodia-db` against the account tied to
	// piotr.putylo96@gmail.com (Session 21 — real Cloudflare deploy). `--local` mode (what
	// `npm run dev`/the platformProxy use) still never calls Cloudflare's API and ignores this id.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "foodia-db",
			"database_id": "6bacf9d0-b5c2-4643-9e14-e1bf39ceee84",
			"migrations_dir": "drizzle"
		}
	]
	// R2 (Session 26) — DELIBERATELY NOT BOUND IN PRODUCTION, see below. The code for it is real and
	// unchanged: POST /api/uploads and GET /api/media/[key] (private bucket, exactly one way in and
	// one way out, both code in this repo, per FUTURES.md 9.5 / Phase 2).
	//
	// The binding is removed rather than the feature, because a Pages deploy fails outright when a
	// declared binding names a bucket that doesn't exist — and R2 is not enabled on this Cloudflare
	// account (`wrangler r2 bucket create` returns code 10042, "Please enable R2 through the
	// Cloudflare Dashboard"). Enabling it requires taking on a subscription with no hard spend cap;
	// Cloudflare offers usage *notifications* but no mechanism that stops the service at the free
	// tier, which is a real, deliberate cost decision rather than a technical one.
	//
	// Nothing regresses by removing it. Both routes already guard the binding's absence
	// (`if (!platform?.env?.MEDIA)` → 503), uploads have never been deployed to production at all,
	// and the feature is gated behind a `can_upload` permission that is off for every account in the
	// database. No existing comment row carries an image_url, so nothing 404s either.
	//
	// To re-enable, once R2 is switched on for the account:
	//   npx wrangler r2 bucket create foodia-media
	// then restore this block:
	//   "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "foodia-media" }]
	// (note the comma that must go back on the d1_databases array above).
}
