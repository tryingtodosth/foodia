{
	"name": "foodia",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:capacitor": "cross-env BUILD_TARGET=capacitor vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"cap:sync": "npm run build:capacitor && npx cap sync",
		"deploy": "vite build && wrangler pages deploy",
		"cf:dev": "vite build && wrangler pages dev"
	},
	"devDependencies": {
		"@capacitor/cli": "^8.4.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.5.0",
		"@sveltejs/vite-plugin-svelte": "^3.1.0",
		"cross-env": "^10.1.0",
		"sass": "^1.77.0",
		"svelte": "^5.0.0",
		"svelte-check": "^3.8.0",
		"typescript": "^5.5.0",
		"vite": "^5.3.0",
		"wrangler": "^4.114.0"
	},
	"dependencies": {
		"@capacitor/core": "^8.4.1"
	}
}
